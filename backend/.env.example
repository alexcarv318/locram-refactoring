# Optional. Defaults work for local runs against production.
# This file is not loaded automatically. Export the vars, or:
#   set -a && source .env && set +a

# Isolated locram home. Default: ~/.locram
# LOCRAM_HOME=/Users/alex-ilchenko/PycharmProjects/locram-new/.locram-dev

# Product API used for Sign In. Default: https://api.locram.app
# LOCRAM_PRODUCT_API_URL=https://api.locram.app

# Hugging Face key fallback if preferences/huggingface-api-key is empty
# LOCRAM_EMBED_API_KEY=
# HUGGINGFACE_API_KEY=
