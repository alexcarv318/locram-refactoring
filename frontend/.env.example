# Optional. Vite loads `.env` automatically. Defaults work for local browser + local backend.

# Local backend. Default probe: http://127.0.0.1:8757 then 8756
# VITE_LOCRAM_BRIDGE_URL=http://127.0.0.1:8757
# VITE_LOCRAM_BRIDGE_URL_BROWSER=http://127.0.0.1:8757

# Product web (billing). No default.
# VITE_LOCRAM_PRODUCT_WEB_URL=https://app.locram.app

# Account web. Typed for the frontend; billing copy mentions it.
# VITE_LOCRAM_ACCOUNT_WEB_URL=https://account.lexrag.com

# E2E only
# VITE_LOCRAM_E2E_SKIP_OPEN_PAGE_REFRESH=1
